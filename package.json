{
  "name": "greenedu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test server/app.test.ts",
    "create:teacher": "node --import tsx server/create-teacher.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src server e2e docs *.ts *.json *.md index.html"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
