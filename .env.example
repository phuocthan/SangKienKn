PORT=3001
DATABASE_PATH=.local/greenedu.sqlite
# Set NODE_ENV=production behind an HTTPS reverse proxy.
# Demo data is created only when SEED_DEMO=1.
SEED_DEMO=1
# Optional password-free access to default teacher/student accounts, loopback only.
LOCAL_QUICK_LOGIN=0
# Welcome emails are disabled until the sending service is connected.
WELCOME_EMAIL_ENABLED=0
# Set these privately in Railway Variables; do not use VITE_ or commit secrets.
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# APP_PUBLIC_URL=https://greenedu.up.railway.app/
